/**
 * Wrangler config for the mtrack application
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtrack",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-24",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "!/api/docs/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "tag": "v2",
      "deleted_classes": [
        "GlobalDurableObject"
      ]
    }
  ]
}